{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AnggaConni/Pocket-UCH/main/data.schema.json",
  "title": "Pocket-UCH Data",
  "type": "object",
  "required": [
    "metadata",
    "summary",
    "sites",
    "site_status",
    "observations",
    "baselines",
    "signals",
    "convention",
    "recommendations",
    "provenance",
    "source_status"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "schema_version",
        "pipeline_version",
        "generated_at",
        "timezone",
        "history_window_days",
        "baseline_window_days",
        "ai_used",
        "global_mode"
      ],
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "pipeline_version": {
          "type": "string"
        },
        "generated_at": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "history_window_days": {
          "type": "integer"
        },
        "baseline_window_days": {
          "type": "integer"
        },
        "ai_used": {
          "type": "boolean"
        },
        "global_mode": {
          "type": "boolean"
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "site_count",
        "observation_count",
        "signal_count",
        "recommendation_count",
        "convention_flagged_sites",
        "status_counts"
      ],
      "properties": {
        "site_count": {
          "type": "integer"
        },
        "observation_count": {
          "type": "integer"
        },
        "signal_count": {
          "type": "integer"
        },
        "recommendation_count": {
          "type": "integer"
        },
        "convention_flagged_sites": {
          "type": "integer"
        },
        "status_counts": {
          "type": "object"
        }
      }
    },
    "sites": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/site"
      }
    },
    "observations": {
      "type": "array"
    },
    "baselines": {
      "type": "array"
    },
    "signals": {
      "type": "array"
    },
    "convention": {
      "type": "object"
    },
    "recommendations": {
      "type": "array"
    },
    "provenance": {
      "type": "array"
    },
    "source_status": {
      "type": "array"
    },
    "legacy": {
      "type": "object"
    },
    "site_status": {
      "type": "array"
    }
  },
  "definitions": {
    "site": {
      "type": "object",
      "required": [
        "id",
        "name",
        "location"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "country": {
          "type": [
            "string",
            "null"
          ]
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "depth_m": {
          "type": [
            "number",
            "null"
          ]
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "type": "object",
          "required": [
            "visibility",
            "representation",
            "geometry"
          ],
          "properties": {
            "visibility": {
              "enum": [
                "public",
                "protected"
              ]
            },
            "representation": {
              "enum": [
                "point",
                "area"
              ]
            },
            "geometry": {
              "type": [
                "object",
                "null"
              ]
            }
          }
        },
        "monitoring": {
          "type": "object"
        },
        "convention_profile": {
          "type": "object"
        }
      }
    }
  }
}