      "type": "object"
    },
    "summary": {
      "type": "object"
    },
    "sites": {
      "type": "array"
    },
    "observations": {
      "type": "array"
    },
    "baselines": {
      "type": "array"
    },
    "signals": {
      "type": "array"
    },
    "convention": {
      "type": "object"
    },
    "recommendations": {
      "type": "array"
    },
    "provenance": {
      "type": "array"
    },
    "source_status": {
      "type": "array"
    },
